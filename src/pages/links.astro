---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { practice } from '../data/content';
import { helpfulLinks, appointmentLink, px, pool } from '../data/pages';
---
<PageLayout title="Helpful Links" description="Trusted websites and health groups for digestive and liver care, chosen by Dr. Narvaez.">
  <PageHero
    title="Helpful links"
    intro="Websites and health groups we trust, for support and for learning more."
    crumbs={[{ label: 'Patient resources' }, { label: 'Links' }]}
    image={px(pool.consult2, 900)}
    imageAlt="A doctor talking with a patient"
  />
  <section class="section bg-ivory text-ink">
    <div class="wrap">
      <ul class="grid gap-6 md:grid-cols-2">
        {helpfulLinks.map((l, i) => (
          <li data-reveal style={`--i:${i % 2}`}>
            <a href={l.href} target="_blank" rel="noopener" class="group flex h-full flex-col rounded-3xl bg-white p-9 ring-1 ring-ink/5 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_24px_50px_-20px_rgba(20,35,63,.35)] hover:ring-gold">
              <h2 class="text-2xl">{l.name} <span class="sr-only">(opens in a new tab)</span></h2>
              <p class="mt-3 text-lg text-ink/70">{l.text}</p>
              <span class="ulink mt-auto self-start pt-6 font-heading">Visit website <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-24 text-4xl font-light md:text-5xl" data-reveal>Stay in touch with us</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        <li data-reveal>
          <a href={appointmentLink} target="_blank" rel="noopener" class="group block rounded-3xl bg-ink p-9 text-ivory transition-transform duration-500 hover:-translate-y-2">
            <h3 class="text-2xl">Request an appointment online <span class="sr-only">(opens in a new tab)</span></h3>
            <p class="mt-3 text-ivory/70">Use our patient portal on Healow.</p>
            <span class="mt-6 inline-block font-heading text-gold-soft">Open the portal ↗</span>
          </a>
        </li>
        <li data-reveal style="--i:1">
          <a href={practice.facebook} target="_blank" rel="noopener" class="group block rounded-3xl bg-ink p-9 text-ivory transition-transform duration-500 hover:-translate-y-2">
            <h3 class="text-2xl">Follow us on Facebook <span class="sr-only">(opens in a new tab)</span></h3>
            <p class="mt-3 text-ivory/70">News and health tips from the office.</p>
            <span class="mt-6 inline-block font-heading text-gold-soft">Visit our page ↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
  <CtaBand />
</PageLayout>
