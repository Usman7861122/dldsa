---
import { posts } from '../../data/content';
---
<section id="blog" class="section bg-ivory text-ink">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <h2 class="text-4xl font-light md:text-6xl">Our blogs</h2>
      <a href="/blog/" class="ulink font-heading text-lg">Read more articles</a>
    </div>

    <ul class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => (
        <li class="flex" data-reveal style={`--i:${i}`}>
          <a href={p.href} class="group flex w-full flex-col">
            <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sand">
              <img src={p.image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-110" />
            </div>
            <h3 class="mt-6 text-2xl font-normal leading-snug transition-colors duration-500 group-hover:text-[#a67a4f] lg:min-h-[4.2rem]">{p.title}</h3>
            <p class="mt-3 text-lg text-ink/70">{p.text}</p>
            <span class="ulink mt-auto self-start pt-6 font-heading">Read article</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
