---
import '../styles/global.css';
import MobileBar from '../components/ui/MobileBar.astro';
import CookieConsent from '../components/react/CookieConsent.tsx';

interface Props { title?: string; description?: string }
const {
  title = 'Digestive & Liver Disease Center of San Antonio | Gastroenterologist in Live Oak, TX',
  description = 'Dr. Robert M. Narvaez treats stomach, colon and liver conditions in San Antonio. Call (210) 650-9119.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <slot />
    <MobileBar />
    <CookieConsent client:load />
    <script>
      const bar = document.getElementById('scroll-progress');
      let ticking = false;
      const update = () => {
        const h = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.transform = `scaleX(${h > 0 ? Math.min(scrollY / h, 1) : 0})`;
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();

      // Soft spotlight that glides after the mouse on dark sections
      const canGlow = matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (canGlow) {
        const hosts = Array.from(document.querySelectorAll<HTMLElement>('section[class*="bg-abyss"], section[class*="bg-midnight"], footer[class*="bg-abyss"]'));
        hosts.forEach((h) => h.classList.add('glow-host'));
        let active: HTMLElement | null = null;
        let px = 0, py = 0;       // pointer, in the page window
        let cx = 0, cy = 0;       // the glow, which follows the pointer slowly
        let raf = 0;
        const frame = () => {
          raf = 0;
          if (!active) return;
          const r = active.getBoundingClientRect();
          const tx = px - r.left, ty = py - r.top;
          cx += (tx - cx) * 0.14; cy += (ty - cy) * 0.14;
          active.style.setProperty('--mx', cx.toFixed(1) + 'px');
          active.style.setProperty('--my', cy.toFixed(1) + 'px');
          if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) raf = requestAnimationFrame(frame);
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };
        const enter = (h: HTMLElement) => {
          if (active === h) return;
          active?.style.setProperty('--glow', '0');
          active = h;
          const r = h.getBoundingClientRect();
          cx = px - r.left; cy = py - r.top;   // start under the pointer, no sliding in from far away
          h.style.setProperty('--glow', '1');
        };
        addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          px = e.clientX; py = e.clientY;
          const host = (e.target as Element | null)?.closest<HTMLElement>('.glow-host') ?? null;
          if (host) enter(host);
          else if (active) { active.style.setProperty('--glow', '0'); active = null; }
          kick();
        }, { passive: true });
        addEventListener('scroll', kick, { passive: true });
        document.documentElement.addEventListener('mouseleave', () => { active?.style.setProperty('--glow', '0'); active = null; });
      }

      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.classList.add('is-in');
            io.unobserve(el);
            // Clear the reveal styles afterwards so hover effects are not slowed down
            setTimeout(() => { el.removeAttribute('data-reveal'); el.classList.remove('is-in'); }, 2200);
          }
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
