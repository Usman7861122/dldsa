---
interface Crumb { label: string; href?: string }
interface Props { title: string; intro?: string; crumbs?: Crumb[]; image?: string; imageAlt?: string; eyebrow?: string }
const { title, intro, crumbs = [], image, imageAlt = '', eyebrow } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-abyss pb-16 pt-36 lg:pb-24 lg:pt-44">
  <div class="pointer-events-none absolute -right-40 -top-40 -z-10 h-[40rem] w-[40rem] rounded-full bg-[radial-gradient(circle,rgba(215,172,131,0.14),transparent_65%)]"></div>
  <div class="pointer-events-none absolute -bottom-60 -left-40 -z-10 h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle,rgba(19,38,74,0.9),transparent_70%)]"></div>
  <div class="wrap">
    <div class={`grid items-center gap-14 ${image ? 'lg:grid-cols-12' : ''}`}>
      <div class={image ? 'lg:col-span-7' : 'max-w-4xl'}>
        <nav aria-label="Breadcrumb" class="text-sm text-ivory/60">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="ulink hover:text-ivory">Home</a></li>
            {crumbs.map((c) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true" class="text-gold/60">/</span>
                {c.href ? <a href={c.href} class="ulink hover:text-ivory">{c.label}</a> : <span aria-current="page" class="text-gold-soft">{c.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
        {eyebrow && <p class="mt-8 font-heading text-sm uppercase tracking-[.2em] text-gold">{eyebrow}</p>}
        <h1 class={`${eyebrow ? 'mt-4' : 'mt-8'} text-balance text-5xl font-light leading-[1.05] md:text-7xl`}>{title}</h1>
        {intro && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ivory/75 md:text-xl">{intro}</p>}
        <div class="mt-9 flex flex-wrap gap-4"><slot /></div>
      </div>
      {image && (
        <div class="lg:col-span-5">
          <div class="group relative mx-auto aspect-[4/5] w-full max-w-sm lg:max-w-none">
            <div class="absolute inset-0 rounded-t-[999px] rounded-b-3xl border border-gold/70 transition-transform duration-700 ease-out group-hover:translate-x-3 group-hover:translate-y-3"></div>
            <div class="absolute inset-0 -translate-x-3 -translate-y-3 overflow-hidden rounded-t-[999px] rounded-b-3xl bg-midnight">
              <img src={image} alt={imageAlt} class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105" fetchpriority="high" />
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
