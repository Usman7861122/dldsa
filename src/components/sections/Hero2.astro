---
import HeroFull from '../react/HeroFull.tsx';
import { practice } from '../../data/content';
const photo = '/images/family-park.jpg';
---
<section class="relative isolate overflow-hidden bg-abyss" style="min-height:100vh;min-height:100svh" aria-label="Welcome">
  <HeroFull client:load image={photo} alt="A smiling mother, father and two daughters hugging on a picnic blanket in a sunny park" />
</section>

<section class="border-b border-gold/15 bg-midnight" aria-label="Visit and hours">
  <div class="wrap">
    <dl class="grid gap-6 py-8 sm:grid-cols-3">
      <div>
        <dt class="font-heading text-sm text-gold">Visit us</dt>
        <dd class="mt-1 text-ivory/85">{practice.address[0]}<br />{practice.address[1]}</dd>
      </div>
      <div>
        <dt class="font-heading text-sm text-gold">Open</dt>
        <dd class="mt-1 text-ivory/85">Mon to Thu, 8 am to 5 pm<br />Fri, 8 am to 12:30 pm</dd>
      </div>
      <div>
        <dt class="font-heading text-sm text-gold">Call</dt>
        <dd class="mt-1"><a href={practice.phoneHref} class="ulink text-ivory/95">{practice.phone}</a></dd>
      </div>
    </dl>
  </div>
</section>
