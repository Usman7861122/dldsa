---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero2 from '../components/sections/Hero2.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import Conditions from '../components/sections/Conditions.astro';
import Procedures from '../components/sections/Procedures.astro';
import Insurance from '../components/sections/Insurance.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Blog from '../components/sections/Blog.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---
<BaseLayout theme="sky" noindex title="Home 2 | Digestive & Liver Disease Center of San Antonio">
  <Header />
  <main>
    <Hero2 />
    <About />
    <Services />
    <Conditions />
    <Procedures />
    <Insurance />
    <Testimonials />
    <Blog />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
