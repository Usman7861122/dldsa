---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ContactForm from '../components/react/ContactForm.tsx';
import { practice } from '../data/content';
import { px, pool, appointmentLink } from '../data/pages';
---
<PageLayout title="Contact Us" description="Call (210) 650-9119 or send a message to the Digestive & Liver Disease Center of San Antonio in Live Oak, TX.">
  <PageHero
    title="Get in touch"
    intro="Send us a message or call the office. We will help you book a visit."
    crumbs={[{ label: 'Contact us' }]}
    image={px(pool.hall, 900)}
    imageAlt="A bright, clean clinic hallway with waiting chairs"
  >
    <a href={practice.phoneHref} class="btn btn-gold">Call {practice.phone}</a>
    <a href={appointmentLink} target="_blank" rel="noopener" class="btn btn-line">Request online <span class="sr-only">(opens in a new tab)</span></a>
  </PageHero>

  <section class="section bg-midnight">
    <div class="wrap grid items-start gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal="left">
        <h2 class="text-4xl font-light md:text-5xl">Send us a message</h2>
        <p class="mt-4 max-w-lg text-ivory/70">Please do not put private health details in this form. For anything urgent, call us. In an emergency, call 911.</p>
        <div class="mt-10"><ContactForm client:visible /></div>
      </div>
      <div class="space-y-5 lg:col-span-5" data-reveal="right">
        <div class="rounded-3xl border border-gold/25 bg-white/[.03] p-8">
          <h3 class="font-heading text-sm text-gold">Visit us</h3>
          <p class="mt-3 text-xl text-ivory/90">{practice.address[0]}<br />{practice.address[1]}</p>
        </div>
        <div class="rounded-3xl border border-gold/25 bg-white/[.03] p-8">
          <h3 class="font-heading text-sm text-gold">Phone and fax</h3>
          <p class="mt-3 text-xl text-ivory/90"><a href={practice.phoneHref} class="ulink">{practice.phone}</a><br /><span class="text-ivory/65">Fax {practice.fax}</span></p>
        </div>
        <div class="rounded-3xl border border-gold/25 bg-white/[.03] p-8">
          <h3 class="font-heading text-sm text-gold">Office hours</h3>
          <dl class="mt-3 space-y-2 text-ivory/85">
            {practice.hours.map((h) => <div class="flex justify-between gap-6"><dt>{h.days}</dt><dd class="text-right text-ivory/65">{h.time}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-abyss py-20 lg:py-28">
    <div class="wrap" data-reveal>
      <div class="group relative h-[26rem] overflow-hidden rounded-3xl border border-gold/30 lg:h-[34rem]">
        <iframe
          title="Map showing the Digestive & Liver Disease Center of San Antonio"
          src={practice.mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="absolute inset-0 h-full w-full border-0 opacity-90 grayscale invert-[.92] hue-rotate-180 contrast-[.9] transition-all duration-700 group-hover:opacity-100 group-hover:grayscale-0 group-hover:invert-0 group-hover:hue-rotate-0 group-hover:contrast-100"
        ></iframe>
      </div>
      <p class="mt-5 text-center text-sm text-ivory/55">Please arrive a few minutes early to fill in forms. <a class="ulink text-gold-soft" href="/forms/">Download forms</a></p>
    </div>
  </section>
</PageLayout>
