---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { blogPosts } from '../data/pages';
const [featured, ...rest] = blogPosts;
---
<PageLayout title="Blog" description="Health articles from Dr. Narvaez on colon cancer, colonoscopy, liver disease, hepatitis C and more.">
  <PageHero
    title="Our blog"
    intro="Clear, helpful articles on digestive and liver health from Dr. Narvaez and our team."
    crumbs={[{ label: 'Blog' }]}
  />

  <section class="section bg-ivory text-ink">
    <div class="wrap">
      <a href={featured.href} target="_blank" rel="noopener" class="group grid items-center gap-10 overflow-hidden rounded-[2rem] bg-white p-4 ring-1 ring-ink/5 transition-shadow duration-500 hover:shadow-[0_30px_60px_-30px_rgba(20,35,63,.4)] lg:grid-cols-2 lg:gap-14 lg:p-5" data-reveal>
        <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sand">
          <img src={featured.image} alt="" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105" fetchpriority="high" />
        </div>
        <div class="pb-6 pr-4 lg:pb-0 lg:pr-10">
          <p class="font-heading text-sm uppercase tracking-[.2em] text-[#a67a4f]">Featured · {featured.tag}</p>
          <h2 class="mt-4 text-3xl font-light leading-tight transition-colors duration-500 group-hover:text-[#a67a4f] md:text-5xl">{featured.title}</h2>
          <p class="mt-5 text-lg text-ink/70">{featured.text}</p>
          <span class="ulink mt-7 inline-block font-heading">Read article <span class="sr-only">(opens in a new tab)</span></span>
        </div>
      </a>

      <ul class="mt-16 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p, i) => (
          <li class="flex" data-reveal style={`--i:${i % 3}`}>
            <a href={p.href} target="_blank" rel="noopener" class="group flex w-full flex-col">
              <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sand">
                <img src={p.image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-110" />
              </div>
              <p class="mt-6 font-heading text-xs uppercase tracking-[.2em] text-[#a67a4f]">{p.tag}</p>
              <h3 class="mt-2 text-2xl font-normal leading-snug transition-colors duration-500 group-hover:text-[#a67a4f] lg:min-h-[4.2rem]">{p.title}</h3>
              <p class="mt-3 text-lg text-ink/70">{p.text}</p>
              <span class="ulink mt-auto self-start pt-6 font-heading">Read article <span class="sr-only">(opens in a new tab)</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand title="Got a question after reading?" text="We are happy to talk it through. Call or send us a message." />
</PageLayout>
