---
import { nav, practice } from '../../data/content';
---
<footer class="bg-abyss pb-10 pt-20">
  <div class="wrap">
    <div data-reveal="fade" class="grid gap-12 border-b border-gold/20 pb-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <img src="/images/Logo.png" alt={practice.name} width="450" height="107" class="h-14 w-auto" loading="lazy" />
        <p class="mt-6 max-w-sm text-ivory/65">Digestive healthcare and gastroenterology in San Antonio, Texas.</p>
      </div>

      <nav aria-label="Footer" class="lg:col-span-3">
        <h3 class="font-heading text-lg text-gold">Explore</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 lg:grid-cols-1">
          {nav.map((n) => <li><a href={n.href} class="ulink text-ivory/75 transition-colors hover:text-ivory">{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <h3 class="font-heading text-lg text-gold">Visit and call</h3>
        <p class="mt-4 text-ivory/75">{practice.address[0]}<br />{practice.address[1]}</p>
        <p class="mt-4"><a href={practice.phoneHref} class="ulink text-ivory/90">{practice.phone}</a></p>
        <a href={practice.facebook} target="_blank" rel="noopener" class="ulink mt-4 inline-block text-ivory/75 hover:text-ivory">Facebook</a>
      </div>
    </div>

    <ul class="flex flex-wrap gap-x-7 gap-y-2 pt-8 text-sm text-ivory/70">
      <li><a href="/privacy-policy/" class="ulink hover:text-ivory">Privacy Policy</a></li>
      <li><a href="/terms-conditions/" class="ulink hover:text-ivory">Terms &amp; Conditions</a></li>
      <li><a href="/accessibility/" class="ulink hover:text-ivory">Accessibility Policy</a></li>
      <li><button type="button" id="open-cookie-settings" class="ulink hover:text-ivory">Cookie settings</button></li>
    </ul>
    <div class="flex flex-col gap-3 pt-6 text-sm text-ivory/50 md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} {practice.name}. All rights reserved.</p>
      <p>This website is for general information and is not medical advice.</p>
    </div>
  </div>
</footer>
<script>
  document.getElementById('open-cookie-settings')?.addEventListener('click', () => window.dispatchEvent(new Event('open-cookie-settings')));
</script>
