---
import { practice } from '../../data/content';
const directions = 'https://www.google.com/maps/dir/?api=1&destination=12315+Judson+Rd+Ste+318+Live+Oak+TX+78233';
---
<nav aria-label="Quick actions" class="fixed inset-x-0 bottom-0 z-[85] border-t border-gold/30 bg-abyss/95 pb-[env(safe-area-inset-bottom)] shadow-[0_-12px_40px_-12px_rgba(0,0,0,.6)] backdrop-blur-xl lg:hidden">
  <div class="mx-auto flex max-w-xl items-stretch gap-2 px-3 py-2.5">
    <a href={practice.phoneHref} class="flex min-w-[4.25rem] flex-col items-center justify-center gap-1 rounded-2xl px-2 text-xs text-ivory/85 transition-colors active:bg-white/10">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>
      <span>Call</span>
    </a>
    <a href="/contact/" class="btn-shiny flex-1 !px-3 !py-3.5 text-[.95rem]"><span>Book an appointment</span></a>
    <a href={directions} target="_blank" rel="noopener" class="flex min-w-[4.25rem] flex-col items-center justify-center gap-1 rounded-2xl px-2 text-xs text-ivory/85 transition-colors active:bg-white/10">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Directions<span class="sr-only"> (opens in a new tab)</span></span>
    </a>
  </div>
</nav>
